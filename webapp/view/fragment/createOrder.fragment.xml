<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:cust="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:ui="sap.suite.ui.commons" xmlns="sap.m">
	<l:VerticalLayout class="sapUiSmallMargin" width="100%">
		<FlexBox alignItems="Start" id="headerForm1" justifyContent="SpaceBetween" width="100%">
			<items>
				<l:VerticalLayout class="" width="100%">
					<l:layoutData>
						<FlexItemData growFactor="2"/>
					</l:layoutData>
					<Text class="orderTitle" id="txt_PosteTechniqe"/>
					<Text class="orderTitle" id="txt_Equipement"/>
					<l:Grid class="sapUiSmallMarginTop" defaultSpan="L4 M6 S12" hSpacing="0">
						<l:content>
							<!-- 1ère ligne -->
							<VBox class="sapUiSmallMarginEnd">
								<layoutData>
									<l:GridData linebreakL="true" linebreakM="true" linebreakS="true" span="L2 M3 S7"/>
								</layoutData>
								<Label text="{i18n>textLblPriority}"/>
								<ComboBox id="cb_priority" items="{ path: '/PRIORITYSet' }" selectionChange="comboWRSelected">
									<core:Item key="{Prior}" text="{Prior} {Description}"/>
								</ComboBox>
							</VBox>
							<VBox class="sapUiSmallMarginEnd">
								<layoutData>
									<l:GridData span="L4 M6 S12"/>
								</layoutData>
								<Label text="{i18n>textFragmentLblActivityType}"/>
								<ComboBox id="cb_typeActivite" items="{ path: '/ACTTYPESet' }" selectionChange="comboWRSelected" selectedKey="Z10" width="200%">
									<core:Item key="{ActType}" text="{ActDesc}"/>
								</ComboBox>
							</VBox>
							<VBox>
								<layoutData>
									<l:GridData span="L3 M6 S12"/>
								</layoutData>
								<Label text="{i18n>textFragmentLblTransmitter}"/>
								<ComboBox id="cb_emmeteur" items="{ path: '/REQUESTERSet' }">
									<core:Item key="{Pernr}" text="{Ename}"/>
								</ComboBox>
							</VBox>
							<VBox>
								<layoutData>
									<l:GridData span="L3 M6 S12"/>
								</layoutData>
								<Label text="{i18n>textFragmentLblWorkcenter}"/>
								<ComboBox id="cb_centreTravail" items="{ path: '/WORKCENTERSet' }">
									<core:Item key="{Arbpl}" text="{Arbpl}"/>
								</ComboBox>
							</VBox>
							<!-- 2eme ligne -->
							<VBox>
								<layoutData>
									<l:GridData span="L3 M6 S12"/>
								</layoutData>
								<Label text="{i18n>textFragmentLblFunCode}"/>
								<ComboBox id="cb_FunCode" items="">
									<core:Item cust:codeGroup="" key="" text="" tooltip=""/>
								</ComboBox>
							</VBox>
							<VBox>
								<layoutData>
									<l:GridData span="L3 M6 S12"/>
								</layoutData>
								<Label text="{i18n>textFragmentLblCatCause}"/>
								<ComboBox id="cb_CatFun" items="">
									<core:Item cust:codeGroup="" key="" text="" tooltip=""/>
								</ComboBox>
							</VBox>
							<VBox>
								<layoutData>
									<l:GridData span="L3 M6 S12"/>
								</layoutData>
								<Label text="{i18n>textFragmentLblCauseCode}"/>
								<ComboBox id="cb_CauseCode" items="">
									<core:Item cust:codeGroup="" key="" text="" tooltip=""/>
								</ComboBox>
							</VBox>
							<VBox>
								<layoutData>
									<l:GridData span="L3 M6 S12"/>
								</layoutData>
								<Label text="{i18n>textFragmentLblCatFunc}"/>
								<ComboBox id="cb_CatFunc" items="">
									<core:Item cust:codeGroup="" key="" text="" tooltip=""/>
								</ComboBox>
							</VBox>
							<!--3ème ligne-->
							<VBox class="sapUiSmallMarginEnd">
								<layoutData>
									<l:GridData linebreakL="true" linebreakM="true" linebreakS="true" span="L3 M6 S12"/>
								</layoutData>
								<Label text="{i18n>textFragmentLblCatFail}"/>
								<ComboBox id="cb_CatFail" items="">
									<core:Item key="" text=""/>
								</ComboBox>
							</VBox>
							<VBox>
								<layoutData>
									<l:GridData span="L3 M6 S12"/>
								</layoutData>
								<Label text="{i18n>textFragmentLblFailCode}"/>
								<ComboBox id="cb_FailCode" items="">
									<core:Item cust:codeGroup="" key="" text="" tooltip=""/>
								</ComboBox>
							</VBox>
							<!--<VBox>-->
							<!--	<layoutData>-->
							<!--		<l:GridData span="L4 M3 S8"/>-->
							<!--	</layoutData>-->
							<!--	<Label text="{i18n>textFragmentLblIntervenant}"/>-->
							<!--	<ComboBox id="cb_intervenant" items="{ path: '/OWNERSet' }">-->
							<!--		<core:Item key="{Pernr}" text="{Ename}"/>-->
							<!--	</ComboBox>-->
							<!--</VBox>-->
						</l:content>
					</l:Grid>
				</l:VerticalLayout>
				<Image class="sapUiMediumMarginBeginEnd" id="_imgPlan" press="imgPlanPressed" enabled="{createOrderViewModel>/imgVisible}" src=""
					width="16rem"/>
			</items>
		</FlexBox>
		<FlexBox alignItems="Start" id="headerForm2">
			<items>
				<Label class="sapUiSmallMargin" text="{i18n>textFragmentLblDescription}"/>
				<TextArea id="headerDesc" width="600%" rows="6" liveChange="textAreaChanged"/>
			</items>
		</FlexBox>
	</l:VerticalLayout>
</core:FragmentDefinition>